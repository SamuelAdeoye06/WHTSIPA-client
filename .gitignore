*.njsproj
*.sln
*.sw?

# Ignore large video files in public (videos are served via Cloudinary)
public/*.mp4
public/*.MP4
public/*.mov
public/*.MOV
# Ignore sensitive local env files
.env
.env.local
*.env.local

# Allow Vite mode-specific env files to be committed (needed by Vercel build)
!.env.development
!.env.production